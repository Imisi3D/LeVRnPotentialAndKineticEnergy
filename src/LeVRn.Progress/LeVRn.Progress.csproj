<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>LeVRn.Progress</RootNamespace>
    <AssemblyName>LeVRn.Progress</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Engine-agnostic core: no UnityEngine, no third-party packages.
         Persistence goes through IStorage so the Unity layer can supply
         Application.persistentDataPath without this assembly referencing Unity. -->
  </PropertyGroup>

</Project>
